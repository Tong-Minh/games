# Copy to .env. Values below work with the local Supabase stack (`pnpm --filter @games/db db:start`);
# run `npx supabase status` in packages/db to see the local secret key.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Any random string of 32+ characters, e.g. `node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"`
GUEST_TOKEN_SECRET=replace-with-a-long-random-string-at-least-32-chars
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PORT=2567
