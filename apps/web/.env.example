# Copy to .env.local. Values below work with the local Supabase stack and game server;
# run `npx supabase status` in packages/db for the keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_GAME_SERVER_URL=http://localhost:2567
# Server-only: used by the account deletion route. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Monetization stays off and invisible until this is "true" (and app_settings agrees).
NEXT_PUBLIC_MONETIZATION_ENABLED=false
